rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The actual server-side boundary for the verification-gated access
    // control pass — src/access/permissions.js's canUseFeature() is a
    // UI-layer convenience only and explicitly says so in its own
    // comment; this is what a client can't bypass by calling Firestore
    // directly. Reads the SAME field (users/{uid}.verifiedCampus) every
    // other verification surface in this app already reads — not a new
    // field, not a second verification concept. get() here costs one
    // extra document read per gated write, same cost pattern the
    // existing chatIsBlocked()/community ownership checks below already
    // accept for their own cross-document rule logic.
    function isVerified() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verifiedCampus', false) == true;
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // calls/{callId}'s real status state machine, enforced server-side
    // (mirrors groupCalls/{callId}'s own forward-only transition check
    // directly below it) — ringing can resolve to active/declined/busy/
    // missed/failed, active can only end in ended/failed, and every
    // terminal status is immutable. Also true (a no-op status "change")
    // when this write isn't touching status at all, e.g. the caller
    // writing their own offer or media-state fields while still ringing.
    function isValidCallStatusTransition() {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == 'ringing' && request.resource.data.status in ['active', 'declined', 'busy', 'missed', 'failed']) ||
        (resource.data.status == 'active' && request.resource.data.status in ['ended', 'failed']);
    }

    // Gamification anti-abuse helpers — a circuit breaker, not
    // server-authoritative enforcement. There is no isAdmin()
    // distinction anywhere in this ruleset (the gamification block
    // below is deliberately open to any signed-in client, since XP is
    // awarded to OTHER users as a side effect of their actions), so
    // these only bound the blast radius of a single malicious write —
    // they cannot stop a determined client from making many small,
    // legal-shaped writes over time. Real enforcement would require
    // moving every award call site behind Cloud Functions.
    function withinDelta(field, maxDelta) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after is number && before is number && (after - before) >= 0 && (after - before) <= maxDelta;
    }
    function withinMagnitude(field, maxDelta) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after is number && before is number && (after - before) <= maxDelta && (before - after) <= maxDelta;
    }

    // Real server-side mirror of blockService.js's blockedUsers check —
    // a blocked party's own blockedUsers subcollection is unreadable to
    // anyone but its owner (see below), but exists() calls made FROM a
    // rule bypass normal read permissions, so this can check both
    // directions without ever exposing either user's block list to the
    // other. Used to gate new chat creation (message-request system).
    function chatIsBlocked(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/blockedUsers/$(uidB)) ||
             exists(/databases/$(database)/documents/users/$(uidB)/blockedUsers/$(uidA));
    }

    // Owner, admin, OR moderator of a community — one get() (via `let`
    // at each call site, not here, since functions can't declare `let`
    // bindings that outlive their own body across multiple returns)
    // used to gate community-staff-only actions that go beyond the
    // existing owner/admin-only pattern above (e.g. pinning a post —
    // Part 13 of the community moderation pass explicitly gives
    // moderators pin/remove/report, not just admins).
    function isCommunityStaff(communityId) {
      let community = get(/databases/$(database)/documents/communities/$(communityId)).data;
      return request.auth.uid == community.ownerId ||
             request.auth.uid in community.get('admins', []) ||
             request.auth.uid in community.get('moderators', []);
    }

    /**
     * =====================================================================
     * INCIDENT NOTE (this pass): a full audit found that firestore.rules
     * has NEVER covered most of this app's collections — chats, messages,
     * communities, follows, likes/comments field carve-outs on posts,
     * notifications, radar, gamification, colleges, lost & found, saved
     * items, and more. Confirmed via full git history: the very first
     * commit that ever added this file already lacked them. Confirmed via
     * a temporary read-only Admin SDK diagnostic (deployed, run once,
     * then removed) that REAL DATA EXISTS in every one of these
     * collections — nothing was deleted; it was simply never readable,
     * because every unlisted collection falls through to the catch-all
     * deny at the bottom of this file. Every rule added below is written
     * to match an exact, already-documented design already sitting in
     * this codebase's own comments (chatService.js, communityService.js,
     * engagementService.js, notificationService.js, profileService.js,
     * radarLocationService.js, blockService.js, muteService.js,
     * reportService.js all describe the specific rule they expected to
     * exist) — restoring intent, not inventing a new security model.
     * =====================================================================
     */

    // users/{uid} — readable by any signed-in user (social feed app:
    // names/avatars/bios must be visible in feeds, profiles, followers
    // lists, comments, Radar, mention search). Writes are owner-only,
    // with one narrow exception: followUser/unfollowUser (profileService.js)
    // updates followersCount/followingCount on the OTHER party's doc as
    // part of the same transaction — that field-scoped carve-out is what
    // makes follow/unfollow work at all.
    // SECURITY FIX (verifiedCampus self-verification bug): this rule
    // previously let the owner of a users/{uid} doc write ANY field,
    // with zero restriction on verifiedCampus — so any signed-in user
    // could set their own verifiedCampus to true via a direct Firestore
    // write (auth/components/CampusVerificationOptions.jsx was doing
    // exactly this from the client; a raw SDK call from devtools would
    // have worked identically even without that UI bug, since this
    // rule was the real, and only, enforcement layer). verifiedCampus
    // is now immutable for every owner-initiated write: create requires
    // it be absent or explicitly false, and update requires the
    // incoming value to equal whatever it already was — a client can
    // never move it in either direction. The only paths that still can
    // are the existing Cloud Functions (adminSetUserVerification,
    // adminReviewVerificationRequest in functions/functions/index.js),
    // which use the Admin SDK and bypass this rule entirely, unaffected
    // by this change. The pre-existing followersCount/followingCount
    // carve-out (any signed-in user, for follow/unfollow side effects)
    // is untouched — it never touched verifiedCampus and still doesn't.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && request.resource.data.get('verifiedCampus', false) == false;
      allow update: if
        (isOwner(uid) && request.resource.data.get('verifiedCampus', false) == resource.data.get('verifiedCampus', false)) ||
        (isSignedIn() && onlyChanged(['followersCount', 'followingCount']));
      allow delete: if false;

      // users/{uid}/notifications/{notificationId} — per notificationService.js's
      // own documented rule: create requires actorUid == requester AND
      // actorUid != uid (no self-notifications); read/delete owner-only;
      // update restricted to the `read` flag only.
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        // Bug fix found while wiring up gamification notifications:
        // `actorUid != uid` unconditionally blocked every "system"
        // notification (badge/level_up/streak use the documented
        // actorUid == uid convention for a non-person sender) from ever
        // being written — createBadgeNotification/createLevelUpNotification/
        // createStreakNotification all silently failed permission-denied
        // (swallowed by their own .catch(() => {})), regardless of who
        // called them, including the legitimate case of one user's
        // action (e.g. liking a post) triggering a badge for a
        // DIFFERENT uid (the post owner) — so `request.auth.uid == uid`
        // can't be required either. Narrowly allow actorUid == uid only
        // for this small, disclosed set of cosmetic system types; a
        // signed-in user could in principle spoof one of these three
        // into another user's inbox, but it can't touch XP, reputation,
        // badges, or the leaderboard (all separately hardened above) —
        // a nuisance ceiling, not a data-integrity one.
        allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid &&
          (request.resource.data.actorUid != uid || request.resource.data.type in ['badge', 'level_up', 'streak']);
        allow update: if isOwner(uid) && onlyChanged(['read']);
        allow delete: if isOwner(uid);
      }

      // Private per-user subcollections — savedPosts (legacy save
      // system, savedService.js's own comment confirms it's kept
      // alongside the newer savedItems/ collection below), blockedUsers
      // (never readable by the blocked party — structurally impossible
      // since only the owner can read their own subcollection at all),
      // mutedUsers, mutedCommunities. All owner-only, every direction.
      match /savedPosts/{postId} {
        allow read, write: if isOwner(uid);
      }
      match /blockedUsers/{blockedUid} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }
      // closeFriends/{friendUid} — mostly the same shape as
      // blockedUsers above, with one deliberate, narrow exception:
      // getCloseFriendsOfMe() (profileService.js) needs to answer "who
      // has added ME," which means reading (only) the specific
      // documents where THIS caller is the named friend, across other
      // people's subcollections — a pure owner-only rule (like
      // blockedUsers) would make that collectionGroup query return
      // nothing, since Firestore evaluates each matched document
      // against this same rule and a non-owner would be rejected on
      // every one. The second read clause grants exactly that: a
      // signed-in user may read a closeFriends doc if THEY are the
      // uid it names — this does not expose the rest of that owner's
      // list (a query naming a different friendUid still only matches
      // documents with a different `uid` field, which this same clause
      // rejects for anyone but that other friend), and it still never
      // reveals WHO the doc's owner is beyond the collectionGroup
      // result's own path (already the point of getCloseFriendsOfMe
      // existing at all — mirrors WhatsApp/Instagram's own "you can't
      // see who added you to their close friends unless it's you"
      // semantics only in the sense that this doesn't ADD unwanted
      // visibility, it's the minimum needed for the feature to work).
      match /closeFriends/{friendUid} {
        allow read: if isOwner(uid) || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
      match /mutedUsers/{mutedUid} {
        allow read, write: if isOwner(uid);
      }
      match /mutedCommunities/{communityId} {
        allow read, write: if isOwner(uid);
      }
      // users/{uid}/devices/{deviceId} — Phase 1 push-notification
      // foundation (deviceService.js). Owner-only in every direction,
      // same shape as blockedUsers/mutedUsers above. update is
      // field-scoped via onlyChanged: a client may only ever touch its
      // own token/version/enabled/timestamp fields, never platform or
      // createdAt (registerDevice() never re-sends those on update
      // either — see that function's own comment). No notification is
      // ever SENT as part of this rule; nothing here does more than
      // let a user manage their own device record.
      match /devices/{deviceId} {
        allow read, create: if isOwner(uid);
        allow update: if isOwner(uid) && onlyChanged(['fcmToken', 'appVersion', 'osVersion', 'enabled', 'updatedAt', 'lastSeenAt']);
        allow delete: if isOwner(uid);
      }
    }

    // posts/{postId} — public read, author-owned writes, plus the
    // specific field-scoped carve-outs engagementService.js's own
    // comments document as already-expected: likedBy/likesCount (any
    // signed-in user liking/unliking), commentsCount (incremented by
    // whoever adds a top-level comment), shareCount (incremented on
    // share), communityDeleted (set by deleteCommunity's cascade when
    // its owner deletes the community).
    match /posts/{postId} {
      allow read: if isSignedIn() && resource.data.visibility == 'public';
      // Verification-gated (verification-access-control pass): matches
      // FEATURES.CREATE_POST's UI gate in CreatePostPage.jsx/
      // PostComposer.jsx — this is the actual enforcement, those are
      // just the friendly UI in front of it.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isVerified();
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        onlyChanged(['likedBy', 'likesCount']) ||
        onlyChanged(['commentsCount']) ||
        onlyChanged(['shareCount']) ||
        onlyChanged(['communityDeleted']) ||
        // Pinning: owner/admin/moderator of the post's OWN community may
        // toggle ONLY the pinned field — never text/media/author fields.
        // A post with no communityId (a general Home post) has no
        // community staff to grant this, so resource.data.communityId
        // must be present for this branch to ever be reachable.
        (onlyChanged(['pinned']) && resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
      );
      // Community owner/admin/moderator may also remove another
      // member's post FROM that community (Part 13's "moderator: Remove"
      // — previously post delete was strictly author-only, a real,
      // narrow moderation gap this closes without touching normal,
      // non-community post deletion at all).
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.communityId != null && isCommunityStaff(resource.data.communityId))
      );

      // posts/{postId}/comments/{commentId} — schema and rule intent
      // both documented directly in engagementService.js. Author owns
      // their comment; any signed-in user may like/unlike
      // (likedBy/likesCount) or toggle pinned; replyCount is
      // incremented by whoever posts a reply. Delete is comment-author
      // or the post's own owner (community-admin moderation of others'
      // comments is not covered here — a narrower, deliberate scope
      // decision, not an oversight; see final report).
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          onlyChanged(['likedBy', 'likesCount']) ||
          onlyChanged(['pinned']) ||
          onlyChanged(['replyCount'])
        );
        allow delete: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid
        );
      }

      // posts/{postId}/pollVotes/{uid} — Phase 4 polls. Doc id IS the
      // voter's own uid (no impersonation possible), and the ONLY
      // allowed operation is create — never update or delete — which is
      // the actual "one vote per user" enforcement: once a vote doc
      // exists, this same rule rejects any attempt to write to that
      // same id again, so a user can never change their vote or vote a
      // second time by racing the client. `optionId` isn't validated
      // against the post's real poll.options list here (would need a
      // get() on the parent post to check membership) — a vote for a
      // nonexistent option is a data-quality non-issue since
      // getPollResults() only ever counts votes matching the real
      // options it already knows about; an invalid optionId simply
      // never gets counted anywhere, not a security bypass. Read is any
      // signed-in user — a NECESSARY tradeoff, not an oversight:
      // getPollResults() uses a count() aggregation query
      // (where('optionId','==',X)), and Firestore can only allow an
      // aggregation/list query when its rule is provably true for every
      // possible matched document without depending on fields the query
      // itself doesn't filter by — an owner-only rule here would be
      // unprovable against a cross-uid optionId filter and break vote
      // counting outright. Stated honestly: individual pollVotes/{uid}
      // documents (who voted for which option) are technically
      // queryable by any signed-in user directly, even though no UI in
      // this app ever surfaces that — only aggregate counts are shown.
      // Tightening this would need routing counts through a Cloud
      // Function (Admin SDK) instead of a client aggregation query, not
      // attempted in this pass.
      // ROOT CAUSE of "poll voting is one-time-only": this previously
      // only allowed `create`, so a first vote succeeded (the doc didn't
      // exist yet) but a second write to the SAME doc id — whether the
      // client called setDoc() or updateDoc(), Firestore rules evaluate
      // that identically as an "update" once the target document already
      // exists — hit `allow update: if false` and was silently rejected.
      // Now: create (first vote), update (change to a different option —
      // same doc id, same owner-only check as create), and delete
      // (unvote) are all allowed, but ONLY for the doc's own owner in
      // every case — the doc id IS the voter's uid, so this can never
      // touch anyone else's vote, and "one active vote per user" still
      // holds structurally: there is exactly one doc per uid no matter
      // how many times they change their mind.
      match /pollVotes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

      // Story privacy pass: visibility can now be 'public' (unchanged
      // behavior — any signed-in user), 'followers' (the owner, or
      // someone with a real follows/{viewerUid}_{ownerId} doc, matching
      // profileService.js's own doc-id convention), or 'closeFriends'
      // (the owner, or someone listed in the owner's own
      // users/{ownerId}/closeFriends/{viewerUid} subcollection). Either
      // restricted tier additionally requires the two parties not be
      // blocked in either direction (chatIsBlocked, already defined
      // above) — "blocked users must never see restricted Stories" is
      // enforced here, not just hidden in the UI, and a direct
      // getStoryById() call for a story the viewer isn't authorized for
      // now genuinely fails at the rules layer instead of just not
      // being surfaced by the feed query.
    match /stories/{storyId} {
      allow read: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.visibility == 'followers' &&
          exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + resource.data.userId)) &&
          !chatIsBlocked(request.auth.uid, resource.data.userId)
        ) ||
        (
          resource.data.visibility == 'closeFriends' &&
          exists(/databases/$(database)/documents/users/$(resource.data.userId)/closeFriends/$(request.auth.uid)) &&
          !chatIsBlocked(request.auth.uid, resource.data.userId)
        )
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      // stories/{storyId}/comments/{commentId} — same shape and same
      // rule pattern as posts/{postId}/comments/{commentId} above (own-
      // comment create/delete, open read), deliberately not gated by
      // verification or blocks — post comments aren't either today, so
      // this mirrors the existing, already-accepted precedent rather
      // than introducing a new, inconsistent restriction.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // storyViews/{storyId}_{viewerUid} — idempotent per-viewer record
    // (storyService.js). Read open to signed-in users (getStoryViewers
    // shows who viewed a story to that story's owner — enforcing
    // "owner only" here would need a get() on the parent story, skipped
    // as an unnecessary restriction for a low-sensitivity read: seeing
    // that someone viewed a public story is not private information).
    // Create restricted to the viewer recording their own view.
    match /storyViews/{viewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.viewerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // storyLikes/{storyId}_{uid} — idempotent per-user like record
    // (storyService.js), same id-format convention as storyViews just
    // above. Unlike a view, a like can be removed (unlike), so delete
    // is allowed for the like's own owner; no update — a like is a
    // binary exists/doesn't-exist relationship, same reasoning as
    // follows/{followId} elsewhere in this file.
    match /storyLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // usernames/{username} — reservation collection. Unchanged from the
    // previous incident fix.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // follows/{followerId}_{followingId} — profileService.js's own
    // comment confirms the intended design exactly: read open to any
    // signed-in user (follower/following lists, mutual-followers,
    // follow-status checks are all cross-user reads), create/delete
    // restricted to the follower themselves (you can only create or
    // remove YOUR OWN follow relationship, never act on someone else's
    // behalf). No update — follow is a binary exists/doesn't-exist
    // relationship, never edited in place.
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // chats/{chatId} — doc id "{uidA}_{uidB}" (1:1) or auto-id (group),
    // schema documented directly in chatService.js. Read/update/delete
    // restricted to participants; create requires the requester to be
    // one of the chat's own listed participants, and (per
    // chatService.js's own MIN_GROUP_MEMBERS comment) a group chat must
    // list at least 3 participants at creation.
    match /chats/{chatId} {
      // `resource == null` guard: getOrCreateChat()'s very first step
      // (and getExistingChatStatus()) reads this exact path to check
      // whether a chat ALREADY exists, for a pair of users who may be
      // messaging each other for the very first time — i.e. the
      // document legitimately does not exist yet. Without this guard,
      // `resource.data.participants` is evaluated on a null resource
      // for that get(), which Firestore treats as a rule-evaluation
      // failure (permission-denied) rather than "not found" — so no
      // brand-new 1:1 conversation could ever be started. Once the
      // document exists, behavior is unchanged: only an actual
      // participant may read it.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);

      // Message Request system: a pending chat's requestedBy must be
      // the actual creator (can't frame someone else as the requester),
      // and creation is refused outright if either side has blocked the
      // other — the server-side half of "B blocks A -> A cannot bypass
      // the block through profile/message route" (block check skipped
      // for group creation, a different, non-request concept).
      //
      // Verification-gated (verification-access-control pass): isVerified()
      // here only ever applies to a genuinely NEW chat document (there is
      // no "create" for one that already exists — that's `update` below,
      // untouched) — matches FEATURES.SEND_MESSAGE's UI gate in
      // StudentProfilePlaceholder.jsx. An unverified user who is messaged
      // FIRST by a verified user can still read/reply in that chat
      // (messages/{messageId}'s own create rule below is unchanged) —
      // only starting new conversations themselves is blocked.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants && isVerified() &&
        (request.resource.data.get('type', 'direct') != 'group' || request.resource.data.participants.size() >= 3) &&
        (request.resource.data.get('status', 'accepted') != 'pending' || request.resource.data.get('requestedBy', '') == request.auth.uid) &&
        (request.resource.data.get('type', 'direct') == 'group' ||
         !chatIsBlocked(request.resource.data.participants[0], request.resource.data.participants[1]));

      // Message Request system, server-side half of acceptMessageRequest()
      // and the pending-message cap: requestedBy is immutable once set
      // (a sender can't reassign who "the requester" is to unlock
      // accept rights); a direct chat's participants list is immutable
      // here (group membership changes are the already-existing,
      // separately-gated admin concern below, untouched); status may
      // only move pending -> accepted, and only by the participant who
      // is NOT the original requester — this is what stops a sender
      // from self-accepting their own request via a raw write, bypassing
      // chatService.js's acceptMessageRequest() entirely. pendingMessageCount
      // may only increase by exactly 1 per update, and only by the
      // requester while still pending — closing the "reset my own
      // counter back to 0 to send more" loophole the same way.
      // Group-admin fields (Phase 3 group-chat pass): the comment above
      // this block previously claimed "group membership changes are
      // the already-existing, separately-gated admin concern below" —
      // that gate never actually existed. Any current participant could
      // add themselves to `admins` (self-promote), rename the group, or
      // change its avatar via a direct write, bypassing
      // chatService.js's own client-side admin checks entirely. Fixed
      // narrowly: a non-admin may update anything else on a group chat
      // exactly as before (lastMessage/readBy/pinnedBy/mutedBy/
      // archivedBy/participants), but `admins`/`groupName`/
      // `groupAvatar` may only change if the requester is already
      // listed in `admins`. Direct (non-group) chats are unaffected —
      // this condition is a no-op for them since it's already
      // satisfied by the "not a group" branch.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants &&
        request.resource.data.get('requestedBy', null) == resource.data.get('requestedBy', null) &&
        (resource.data.get('type', 'direct') == 'group' || request.resource.data.participants == resource.data.participants) &&
        (
          resource.data.get('type', 'direct') != 'group' ||
          request.auth.uid in resource.data.get('admins', []) ||
          (
            request.resource.data.get('admins', resource.data.get('admins', [])) == resource.data.get('admins', []) &&
            request.resource.data.get('groupName', resource.data.get('groupName', '')) == resource.data.get('groupName', '') &&
            request.resource.data.get('groupAvatar', resource.data.get('groupAvatar', '')) == resource.data.get('groupAvatar', '')
          )
        ) &&
        (
          request.resource.data.status == resource.data.status ||
          (resource.data.status == 'pending' && request.resource.data.status == 'accepted' &&
           request.auth.uid != resource.data.get('requestedBy', ''))
        ) &&
        (
          request.resource.data.get('pendingMessageCount', 0) == resource.data.get('pendingMessageCount', 0) ||
          (resource.data.status == 'pending' && request.auth.uid == resource.data.get('requestedBy', '') &&
           request.resource.data.pendingMessageCount == resource.data.get('pendingMessageCount', 0) + 1)
        ) &&
        // deletedFor — "delete chat for me" (deleteChat in chatService.js).
        // Three allowed shapes, narrowest first: (1) unchanged — the
        // overwhelming majority of writes to this doc never touch it;
        // (2) reset to empty — sendMessage() clears it as part of its
        // normal lastMessage/lastMessageAt update whenever a new message
        // resurrects a conversation someone had deleted, so this must be
        // allowed alongside those other field changes, not just alone;
        // (3) the dedicated delete-for-me write itself, scoped to ONLY
        // that field and requiring the caller's own uid to be the one
        // added — the exact same shape already used for a message's own
        // deletedFor (messages/{messageId}'s update rule below), applied
        // one level up to the chat doc itself.
        (
          request.resource.data.get('deletedFor', []) == resource.data.get('deletedFor', []) ||
          request.resource.data.get('deletedFor', []) == [] ||
          (onlyChanged(['deletedFor']) && request.auth.uid in request.resource.data.deletedFor)
        );

      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      // chats/{chatId}/messages/{messageId} — participant-only in every
      // direction; create requires the sender field to match the
      // requester; delete restricted to the message's own sender
      // (deleteMessageForEveryone), matching chatService.js exactly.
      // Message Request system: while the parent chat is 'pending',
      // only the original requester may create a message at all, and
      // only while the chat doc's own pendingMessageCount is still under
      // the 1-message cap — the real backend enforcement of "only one
      // message while pending" (chatService.js's own check is the same
      // rule expressed client-side for a fast, friendly error; this is
      // what actually stops a malicious client from calling addDoc here
      // directly, repeatedly, bypassing that transaction).
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.status != 'pending' ||
            (
              request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('requestedBy', '') &&
              get(/databases/$(database)/documents/chats/$(chatId)).data.get('pendingMessageCount', 0) < 1
            )
          );
        // Tightened for the reactions/edit/delete pass — the previous
        // rule let ANY participant update ANY field of ANY message
        // (needed at the time only because read receipts are written by
        // the RECIPIENT, not the sender). editMessage()/
        // deleteMessageForMe() already enforced their own restrictions
        // client-side, but that's a UI-layer check only — a client
        // calling Firestore directly could have edited someone else's
        // message text. Now scoped to exactly the 4 real update shapes
        // this app ever performs on a message: (1) the sender editing
        // their own text, (2) any participant marking `read` (existing
        // markChatRead batch + realtime receipts, unchanged), (3) any
        // participant adding ONLY their own uid to `deletedFor` ("delete
        // for me"), (4) any participant toggling ONLY their own key in
        // `reactions` (one reaction per user — a second reaction from
        // the same uid overwrites their own key, never adds a new one).
        allow update: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          (
            (resource.data.senderId == request.auth.uid && onlyChanged(['text', 'edited', 'editedAt'])) ||
            onlyChanged(['read']) ||
            (onlyChanged(['deletedFor']) && request.auth.uid in request.resource.data.deletedFor) ||
            (onlyChanged(['reactions']) &&
              request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
          );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }

      // chats/{chatId}/typing/{uid} — ephemeral typing-presence only,
      // never a message (real-time typing indicator pass). Doc id IS
      // the typer's own uid, so no one can write typing state as
      // someone else; both read and write additionally require the
      // caller to already be a listed participant of the PARENT chat,
      // same get()-on-parent pattern messages/{messageId} above already
      // uses — so typing state can never leak outside a conversation,
      // and never bypasses the participant/verification/block checks on
      // the chat's own create rule (this only ever operates on a chat
      // document that already exists).
      match /typing/{uid} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow write: if isSignedIn() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // calls/{callId} — WebRTC signaling for 1:1 voice/video calls
    // (callService.js). Restricted to the two named participants
    // (callerUid/calleeUid) in every direction, the same participant-
    // only pattern as chats/{chatId} above. offer/answer SDP live on
    // the call doc itself; ICE candidates live in two subcollections
    // (one per side) so each side can only ever write its OWN
    // candidates, never forge the other's.
    match /calls/{callId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerUid;

      // Hardened from a previous unconditional "either participant may
      // change ANY field" rule — that let either side rewrite the
      // other's SDP fields, forge callerUid/calleeUid/chatId/type/
      // createdAt, or move status backward (e.g. reopen an already-
      // 'ended' call). Now field- and role-scoped: the caller may only
      // ever touch their own offer/media-state fields, the callee only
      // their own answer/media-state fields, both may advance status/
      // timestamps but only through isValidCallStatusTransition()'s
      // real forward-only state machine (mirrors groupCalls' own rule
      // below). callerMuted/callerCameraOff/calleeMuted/calleeCameraOff
      // are the real remote mute/camera-off signal (callService.js's
      // setCallMediaState) — each side can only ever publish their OWN
      // state, never the other's.
      allow update: if isSignedIn() && isValidCallStatusTransition() && (
        (request.auth.uid == resource.data.callerUid &&
          onlyChanged(['offer', 'callerMuted', 'callerCameraOff', 'status', 'updatedAt', 'endedAt'])) ||
        (request.auth.uid == resource.data.calleeUid &&
          onlyChanged(['answer', 'calleeMuted', 'calleeCameraOff', 'status', 'updatedAt', 'endedAt']))
      );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
        );
        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid;
        allow update, delete: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid
        );
        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid;
        allow update, delete: if false;
      }
    }

    // groupCalls/{callId} — WebRTC MESH signaling for group calls
    // (groupCallService.js), new and additive alongside calls/{callId}
    // above, not a replacement. The real security boundary everywhere
    // in this tree is the SAME check, repeated at each level: the
    // caller must be a genuine member of the group chat this call
    // belongs to (get() on the real chats/{chatId} doc, never trusting
    // this call doc's own denormalized `participantUids` field, which
    // is only ever a query convenience — someone could in principle
    // write a bogus participantUids array, but every actual read/write
    // below is independently re-checked against the real chat roster,
    // so a spoofed array can't grant access to anything).
    match /groupCalls/{callId} {
      allow read: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.hostUid &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.get('type', 'direct') == 'group';

      // Only status (+ its timestamps) may ever change here, only by a
      // real member, and only moving forward — ringing->active/ended,
      // active->ended. Never backward, never any other field.
      allow update: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants &&
        onlyChanged(['status', 'updatedAt', 'endedAt']) &&
        (
          (resource.data.status == 'ringing' && request.resource.data.status in ['active', 'ended']) ||
          (resource.data.status == 'active' && request.resource.data.status == 'ended')
        );

      allow delete: if false;

      // participants/{uid} — one doc per person, doc id IS their own
      // uid (mirrors typing/{uid}'s own "can't write as someone else"
      // pattern), so a participant can only ever create/update their
      // OWN join state, never anyone else's.
      match /participants/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
        allow create, update: if isSignedIn() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
        allow delete: if false;
      }

      // peerLinks/{fromUid_toUid} — one signaling doc per ordered pair.
      // Only the initiator (fromUid) may create it (writes the offer);
      // only the recipient (toUid) may update it, and only to add the
      // answer — the same "each side owns exactly their own half"
      // shape calls/{callId} already uses for offer vs answer, just
      // split across who's allowed to touch which field instead of one
      // shared caller/callee doc.
      match /peerLinks/{pairId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.fromUid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
        allow update: if isSignedIn() && request.auth.uid == resource.data.toUid && onlyChanged(['answer']);
        allow delete: if false;

        match /fromCandidates/{candidateId} {
          allow read: if isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
          allow create: if isSignedIn() &&
            request.auth.uid == get(/databases/$(database)/documents/groupCalls/$(callId)/peerLinks/$(pairId)).data.fromUid;
          allow update, delete: if false;
        }
        match /toCandidates/{candidateId} {
          allow read: if isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(get(/databases/$(database)/documents/groupCalls/$(callId)).data.chatId)).data.participants;
          allow create: if isSignedIn() &&
            request.auth.uid == get(/databases/$(database)/documents/groupCalls/$(callId)/peerLinks/$(pairId)).data.toUid;
          allow update, delete: if false;
        }
      }
    }

    // communities/{communityId} — public discovery read. Create by the
    // declared owner only. Update: the owner may change anything;
    // an existing admin may change only the fields
    // updateCommunityDetails's own comment documents as admin-editable
    // (description/coverImage/icon/tags/rules) plus the admins/
    // moderators arrays (promote/demote); any signed-in user may adjust
    // ONLY membersCount, as a side effect of joining/leaving. Delete is
    // owner-only (deleteCommunity).
    match /communities/{communityId} {
      allow read: if isSignedIn();
      // Verification-gated: matches FEATURES.CREATE_COMMUNITY's existing
      // UI gate (DesktopRightRail.jsx, CreateCommunityPage.jsx).
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && isVerified();
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.uid in resource.data.admins &&
          onlyChanged(['description', 'coverImage', 'icon', 'tags', 'rules', 'admins', 'moderators'])) ||
        onlyChanged(['membersCount'])
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // communities/{communityId}/channels/{channelId} — real per-
      // community documents (createCommunity writes the 4 defaults;
      // createCommunityChannel lets an owner/admin add more), not a
      // hardcoded UI list. Read open, same reasoning as the parent
      // community doc (channel names aren't private). Create/update/
      // delete owner/admin-only — a plain member can browse channels
      // but never create, rename, or remove one.
      match /channels/{channelId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.admins
        );
      }
    }

    // communityMembers/{communityId}_{uid} — communityService.js's own
    // comment confirms the schema. Read open (member lists/roles are
    // normal social-app data, not private). Create: the member joining
    // themselves (joinCommunity/createCommunity's owner doc), OR the
    // community's owner/admin admitting someone else (acceptRequest).
    // Update/delete (role changes, leaving, being removed): the member
    // themselves, or the community's owner/admin.
    match /communityMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        !exists(/databases/$(database)/documents/communityBans/$(request.resource.data.communityId + '_' + request.resource.data.uid)) && (
          get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.admins ||
          request.resource.data.uid == request.auth.uid
        )
      );
      allow update: if isSignedIn() && (
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins ||
        // Mute Community: a member may flip ONLY their own `muted` flag
        // on their own membership doc — never their role, never anyone
        // else's doc. Everything else about this doc (role changes) stays
        // owner/admin-only exactly as before.
        (resource.data.uid == request.auth.uid && onlyChanged(['muted']))
      );
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins
      );
    }

    // communityBans/{communityId}_{uid} — same deterministic composite-id
    // reservation pattern as communityMembers/communityRequests above.
    // Read open (join/leave flows and the Members UI need to know ban
    // state). Create/delete (ban/unban) restricted to the target
    // community's own owner/admin — enforced HERE, not just hidden by a
    // disabled button, per the explicit "do not create a client-only
    // fake ban" requirement. joinCommunity/requestToJoin's own create
    // rules below additionally check this collection so a banned user
    // can't rejoin by calling the client function directly.
    match /communityBans/{banId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.admins
      );
      allow delete: if isSignedIn() && (
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins
      );
      allow update: if false;
    }

    // communityRequests/{communityId}_{uid} — requestToJoin creates its
    // own; read/delete available to the requester themselves or the
    // community's owner/admin (viewing/accepting/rejecting requests).
    match /communityRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins
      );
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/communityBans/$(request.resource.data.communityId + '_' + request.auth.uid));
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins
      );
      allow update: if false;
    }

    // communityHandles/{handle} — same reservation pattern as
    // usernames/{}. Read open (handle-availability checks); create/
    // delete restricted to the reservation's own owner (createCommunity
    // reserves it, deleteCommunity releases it).
    match /communityHandles/{handle} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // colleges/{collegeId} — public reference data (onboarding college
    // search, community college filter). Read-only for clients; writes
    // only ever happen via collegeRequestService.js's admin-approval
    // transaction, which this pass deliberately does NOT re-enable —
    // that flow depends on the platformAdmins-based admin check this
    // project has already moved away from (see final report). Colleges
    // already in the database remain fully readable either way.
    match /colleges/{collegeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // collegeRequests/{requestId} — any signed-in user may submit a
    // request to add a missing college (AddCollegePage.jsx). Reading/
    // reviewing requests is an admin action, intentionally left
    // unavailable for the same reason as colleges/ above.
    match /collegeRequests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // lostFound/{itemId} — public campus board; only the poster can
    // edit/remove their own listing (createLostFoundItem's own comment:
    // "authenticated uid passed in — never trusted from anywhere else").
    match /lostFound/{itemId} {
      allow read: if isSignedIn();
      // Verification-gated: matches FEATURES.CREATE_LOST_FOUND's UI gate
      // in LostFoundPage.jsx.
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && isVerified();
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // products/{productId} — Marketplace. marketplaceService.js's own
    // comment confirms the intent exactly: "the real authorization
    // boundary is the Firestore rule itself ... never trust sellerId
    // from client." Public read (browsing/searching listings); create
    // requires the declared sellerId to match the requester; only the
    // seller may edit or remove their own listing. This collection had
    // zero rule coverage before this pass — the same class of gap as
    // chats/communities/follows found and fixed earlier — which is why
    // Marketplace never actually loaded any data despite real products
    // existing in the database.
    match /products/{productId} {
      allow read: if isSignedIn();
      // Verification-gated: matches FEATURES.CREATE_MARKETPLACE_LISTING's
      // UI gate in CreateProductPage.jsx.
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid && isVerified();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // savedItems/{uid}/items/{itemId} and savedCollections/{uid}/collections/{id}
    // — private, owner-only bookmarking system (savedService.js).
    match /savedItems/{uid}/items/{itemId} {
      allow read, write: if isOwner(uid);
    }
    match /savedCollections/{uid}/collections/{collectionId} {
      allow read, write: if isOwner(uid);
    }

    // reports/{reportId} — reportService.js's own comment documents the
    // exact intended rule: create requires reporterUid == requester;
    // read/update/delete are admin-only. Admin review now happens via
    // adminResolveReport/adminListReports (Cloud Functions, Admin SDK —
    // bypasses these rules entirely), not a client-side platformAdmins
    // check, so read/update/delete stay denied for every client here.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // announcements/{announcementId} — Phase 2 campus announcements.
    // Write is admin-only, same shape as reports/verificationRequests'
    // admin-side above: every write (create/pin/delete) goes through
    // adminSendNotification/adminSetAnnouncementPinned/
    // adminDeleteAnnouncement (Cloud Functions, Admin SDK, bypasses
    // this rule entirely), never a direct client write — "do NOT let
    // every random user create official-looking announcements" is
    // enforced here, not just hidden in the UI. Read is open to any
    // signed-in user; the client query itself scopes to the viewer's
    // own collegeId (or the null/platform-wide ones) — this rule
    // doesn't restrict by college because it's public campus-notice
    // content, not private data.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // radarLocations/{uid} — radarLocationService.js's own comment
    // documents this exactly: "Read: any signed-in user (required)...
    // Write: owner only."
    match /radarLocations/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // Gamification — userProgress/{uid}, userBadges/{uid}/earned/{id},
    // xpLog/{uid}/entries/{id}. XP/badges are awarded to OTHER users as
    // a side effect of their actions (e.g. liking someone's post awards
    // THEM xp, not you), so these cannot be owner-only for write.
    //
    // Hardened from a previous fully-open allow write: if isSignedIn()
    // with no field validation at all. Now: numeric fields can only
    // move by a bounded amount per write and (other than reputation,
    // which must be able to decrease for moderation penalties) can
    // never decrease; xpLog entries and earned badges are immutable
    // once created. verifiedCampus is deliberately left OUT of the
    // client-writable field set — it's only ever set by the
    // Admin-SDK-backed Cloud Functions in functions/functions/index.js
    // (which bypass these rules entirely), so a client can never
    // self-grant the Verified Campus badge's underlying flag.
    match /userProgress/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        onlyChanged([
          'xp', 'level', 'campusPoints', 'reputationScore', 'contributionsCount',
          'currentStreak', 'longestStreak', 'lastActivityDate', 'badgeCount',
          'collegeId', 'profileCompletionPct', 'updatedAt'
        ]) &&
        withinDelta('xp', 1000) &&
        withinDelta('campusPoints', 1000) &&
        withinDelta('contributionsCount', 5) &&
        withinDelta('badgeCount', 5) &&
        withinDelta('currentStreak', 1000) &&
        withinDelta('longestStreak', 1000) &&
        withinMagnitude('reputationScore', 200);
      allow delete: if false;
    }
    match /userBadges/{uid}/earned/{badgeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Owner may flip seen:false -> true only (BadgeUnlockToast.jsx's
      // one-time achievement toast) — nothing else on an earned badge
      // is ever client-editable.
      allow update: if isOwner(uid) && onlyChanged(['seen']);
      allow delete: if false;
    }
    match /xpLog/{uid}/entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // verificationRequests/{requestId} — created during onboarding's
    // campus-verification step. Only the submitting user may create or
    // read their own request; no listing, no updates, no deletes from
    // the client (reviewed by an admin process later).
    match /verificationRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Verified Campus Certificates — users/{uid}/achievementSubmissions
    // (create-only, owner-only-readable, same "no listing beyond your
    // own subcollection, no client update, reviewed by an admin process
    // later" shape as verificationRequests above) and
    // users/{uid}/verifiedAchievements (the OFFICIAL record — never
    // client-writable at all; only the Admin-SDK Cloud Function
    // adminReviewAchievementSubmission creates these, which bypasses
    // these rules entirely, so a user can never self-award, edit, or
    // delete a verified achievement). verifiedAchievements is
    // deliberately readable by ANY signed-in user (not owner-only) —
    // it's meant to show on a public profile, same visibility as
    // userBadges — and deliberately holds no fileUrl/documentPath field
    // at all, so there is no path by which reading it could leak the
    // private uploaded certificate.
    match /users/{uid}/achievementSubmissions/{submissionId} {
      allow create: if isOwner(uid) && request.resource.data.userId == uid && request.resource.data.status == 'pending';
      allow read: if isOwner(uid);
      allow update, delete: if false;
    }
    match /users/{uid}/verifiedAchievements/{achievementId} {
      allow read: if isSignedIn();
      allow update: if isOwner(uid) && onlyChanged(['seen']);
      allow create, delete: if false;
    }

    // emailVerificationTokens/{tokenHash} — custom email verification.
    // Written and read exclusively by Cloud Functions via the Admin SDK
    // (which bypasses these rules entirely), never by the client. No
    // client, including the token's own owner, may create, read,
    // update, or delete a token, or otherwise influence emailVerified.
    // Already covered by the catch-all below; stated explicitly here
    // for auditability given how security-sensitive this collection is.
    match /emailVerificationTokens/{tokenHash} {
      allow read, write: if false;
    }

    // emailVerificationRateLimits/{uid} — server-only counters backing
    // resendEmailVerification's rate limit. Same rationale as above.
    match /emailVerificationRateLimits/{uid} {
      allow read, write: if false;
    }

    // emailVerificationActiveTokens/{uid} — server-only pointer to each
    // user's current live token, used to invalidate a previous token
    // without a compound query. Same rationale as above.
    match /emailVerificationActiveTokens/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default — Firestore is NOT public.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
