[debug] [2026-09-15T09:02:05.330Z] <<< [apiv2][status] POST https://firebaserules.googleapis.com/v1/projects/campinity-app/rulesets 200
[debug] [2026-09-15T09:02:05.330Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/campinity-app/rulesets {"name":"projects/campinity-app/rulesets/31cc912e-50a6-48be-959a-52310ec71731","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    function onlyChanged(fields) {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);\n    }\n\n    // Real server-side mirror of blockService.js's blockedUsers check —\n    // a blocked party's own blockedUsers subcollection is unreadable to\n    // anyone but its owner (see below), but exists() calls made FROM a\n    // rule bypass normal read permissions, so this can check both\n    // directions without ever exposing either user's block list to the\n    // other. Used to gate new chat creation (message-request system).\n    function chatIsBlocked(uidA, uidB) {\n      return exists(/databases/$(database)/documents/users/$(uidA)/blockedUsers/$(uidB)) ||\n             exists(/databases/$(database)/documents/users/$(uidB)/blockedUsers/$(uidA));\n    }\n\n    /**\n     * =====================================================================\n     * INCIDENT NOTE (this pass): a full audit found that firestore.rules\n     * has NEVER covered most of this app's collections — chats, messages,\n     * communities, follows, likes/comments field carve-outs on posts,\n     * notifications, radar, gamification, colleges, lost & found, saved\n     * items, and more. Confirmed via full git history: the very first\n     * commit that ever added this file already lacked them. Confirmed via\n     * a temporary read-only Admin SDK diagnostic (deployed, run once,\n     * then removed) that REAL DATA EXISTS in every one of these\n     * collections — nothing was deleted; it was simply never readable,\n     * because every unlisted collection falls through to the catch-all\n     * deny at the bottom of this file. Every rule added below is written\n     * to match an exact, already-documented design already sitting in\n     * this codebase's own comments (chatService.js, communityService.js,\n     * engagementService.js, notificationService.js, profileService.js,\n     * radarLocationService.js, blockService.js, muteService.js,\n     * reportService.js all describe the specific rule they expected to\n     * exist) — restoring intent, not inventing a new security model.\n     * =====================================================================\n     */\n\n    // users/{uid} — readable by any signed-in user (social feed app:\n    // names/avatars/bios must be visible in feeds, profiles, followers\n    // lists, comments, Radar, mention search). Writes are owner-only,\n    // with one narrow exception: followUser/unfollowUser (profileService.js)\n    // updates followersCount/followingCount on the OTHER party's doc as\n    // part of the same transaction — that field-scoped carve-out is what\n    // makes follow/unfollow work at all.\n    match /users/{uid} {\n      allow read: if isSignedIn();\n      allow create: if isOwner(uid);\n      allow update: if isOwner(uid) || (isSignedIn() && onlyChanged(['followersCount', 'followingCount']));\n      allow delete: if false;\n\n      // users/{uid}/notifications/{notificationId} — per notificationService.js's\n      // own documented rule: create requires actorUid == requester AND\n      // actorUid != uid (no self-notifications); read/delete owner-only;\n      // update restricted to the `read` flag only.\n      match /notifications/{notificationId} {\n        allow read: if isOwner(uid);\n        allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid && request.resource.data.actorUid != uid;\n        allow update: if isOwner(uid) && onlyChanged(['read']);\n        allow delete: if isOwner(uid);\n      }\n\n      // Private per-user subcollections — savedPosts (legacy save\n      // system, savedService.js's own comment confirms it's kept\n      // alongside the newer savedItems/ collection below), blockedUsers\n      // (never readable by the blocked party — structurally impossible\n      // since only the owner can read their own subcollection at all),\n      // mutedUsers, mutedCommunities. All owner-only, every direction.\n      match /savedPosts/{postId} {\n        allow read, write: if isOwner(uid);\n      }\n      match /blockedUsers/{blockedUid} {\n        allow read, create, delete: if isOwner(uid);\n        allow update: if false;\n      }\n      match /mutedUsers/{mutedUid} {\n        allow read, write: if isOwner(uid);\n      }\n      match /mutedCommunities/{communityId} {\n        allow read, write: if isOwner(uid);\n      }\n    }\n\n    // posts/{postId} — public read, author-owned writes, plus the\n    // specific field-scoped carve-outs engagementService.js's own\n    // comments document as already-expected: likedBy/likesCount (any\n    // signed-in user liking/unliking), commentsCount (incremented by\n    // whoever adds a top-level comment), shareCount (incremented on\n    // share), communityDeleted (set by deleteCommunity's cascade when\n    // its owner deletes the community).\n    match /posts/{postId} {\n      allow read: if isSignedIn() && resource.data.visibility == 'public';\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn() && (\n        resource.data.userId == request.auth.uid ||\n        onlyChanged(['likedBy', 'likesCount']) ||\n        onlyChanged(['commentsCount']) ||\n        onlyChanged(['shareCount']) ||\n        onlyChanged(['communityDeleted'])\n      );\n      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n\n      // posts/{postId}/comments/{commentId} — schema and rule intent\n      // both documented directly in engagementService.js. Author owns\n      // their comment; any signed-in user may like/unlike\n      // (likedBy/likesCount) or toggle pinned; replyCount is\n      // incremented by whoever posts a reply. Delete is comment-author\n      // or the post's own owner (community-admin moderation of others'\n      // comments is not covered here — a narrower, deliberate scope\n      // decision, not an oversight; see final report).\n      match /comments/{commentId} {\n        allow read: if isSignedIn();\n        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n        allow update: if isSignedIn() && (\n          resource.data.userId == request.auth.uid ||\n          onlyChanged(['likedBy', 'likesCount']) ||\n          onlyChanged(['pinned']) ||\n          onlyChanged(['replyCount'])\n        );\n        allow delete: if isSignedIn() && (\n          resource.data.userId == request.auth.uid ||\n          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid\n        );\n      }\n    }\n\n    // stories/{storyId} — same read/write pattern as posts. Unchanged.\n    match /stories/{storyId} {\n      allow read: if isSignedIn() && resource.data.visibility == 'public';\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;\n      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;\n    }\n\n    // storyViews/{storyId}_{viewerUid} — idempotent per-viewer record\n    // (storyService.js). Read open to signed-in users (getStoryViewers\n    // shows who viewed a story to that story's owner — enforcing\n    // \"owner only\" here would need a get() on the parent story, skipped\n    // as an unnecessary restriction for a low-sensitivity read: seeing\n    // that someone viewed a public story is not private information).\n    // Create restricted to the viewer recording their own view.\n    match /storyViews/{viewId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.viewerUid == request.auth.uid;\n      allow update, delete: if false;\n    }\n\n    // usernames/{username} — reservation collection. Unchanged from the\n    // previous incident fix.\n    match /usernames/{username} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;\n      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;\n    }\n\n    // follows/{followerId}_{followingId} — profileService.js's own\n    // comment confirms the intended design exactly: read open to any\n    // signed-in user (follower/following lists, mutual-followers,\n    // follow-status checks are all cross-user reads), create/delete\n    // restricted to the follower themselves (you can only create or\n    // remove YOUR OWN follow relationship, never act on someone else's\n    // behalf). No update — follow is a binary exists/doesn't-exist\n    // relationship, never edited in place.\n    match /follows/{followId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;\n      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;\n      allow update: if false;\n    }\n\n    // chats/{chatId} — doc id \"{uidA}_{uidB}\" (1:1) or auto-id (group),\n    // schema documented directly in chatService.js. Read/update/delete\n    // restricted to participants; create requires the requester to be\n    // one of the chat's own listed participants, and (per\n    // chatService.js's own MIN_GROUP_MEMBERS comment) a group chat must\n    // list at least 3 participants at creation.\n    match /chats/{chatId} {\n      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;\n\n      // Message Request system: a pending chat's requestedBy must be\n      // the actual creator (can't frame someone else as the requester),\n      // and creation is refused outright if either side has blocked the\n      // other — the server-side half of \"B blocks A -> A cannot bypass\n      // the block through profile/message route\" (block check skipped\n      // for group creation, a different, non-request concept).\n      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants &&\n        (request.resource.data.get('type', 'direct') != 'group' || request.resource.data.participants.size() >= 3) &&\n        (request.resource.data.get('status', 'accepted') != 'pending' || request.resource.data.get('requestedBy', '') == request.auth.uid) &&\n        (request.resource.data.get('type', 'direct') == 'group' ||\n         !chatIsBlocked(request.resource.data.participants[0], request.resource.data.participants[1]));\n\n      // Message Request system, server-side half of acceptMessageRequest()\n      // and the pending-message cap: requestedBy is immutable once set\n      // (a sender can't reassign who \"the requester\" is to unlock\n      // accept rights); a direct chat's participants list is immutable\n      // here (group membership changes are the already-existing,\n      // separately-gated admin concern below, untouched); status may\n      // only move pending -> accepted, and only by the participant who\n      // is NOT the original requester — this is what stops a sender\n      // from self-accepting their own request via a raw write, bypassing\n      // chatService.js's acceptMessageRequest() entirely. pendingMessageCount\n      // may only increase by exactly 1 per update, and only by the\n      // requester while still pending — closing the \"reset my own\n      // counter back to 0 to send more\" loophole the same way.\n      allow update: if isSignedIn() && request.auth.uid in resource.data.participants &&\n        request.resource.data.get('requestedBy', null) == resource.data.get('requestedBy', null) &&\n        (resource.data.get('type', 'direct') == 'group' || request.resource.data.participants == resource.data.participants) &&\n        (\n          request.resource.data.status == resource.data.status ||\n          (resource.data.status == 'pending' && request.resource.data.status == 'accepted' &&\n           request.auth.uid != resource.data.get('requestedBy', ''))\n        ) &&\n        (\n          request.resource.data.get('pendingMessageCount', 0) == resource.data.get('pendingMessageCount', 0) ||\n          (resource.data.status == 'pending' && request.auth.uid == resource.data.get('requestedBy', '') &&\n           request.resource.data.pendingMessageCount == resource.data.get('pendingMessageCount', 0) + 1)\n        );\n\n      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;\n\n      // chats/{chatId}/messages/{messageId} — participant-only in every\n      // direction; create requires the sender field to match the\n      // requester; delete restricted to the message's own sender\n      // (deleteMessageForEveryone), matching chatService.js exactly.\n      // Message Request system: while the parent chat is 'pending',\n      // only the original requester may create a message at all, and\n      // only while the chat doc's own pendingMessageCount is still under\n      // the 1-message cap — the real backend enforcement of \"only one\n      // message while pending\" (chatService.js's own check is the same\n      // rule expressed client-side for a fast, friendly error; this is\n      // what actually stops a malicious client from calling addDoc here\n      // directly, repeatedly, bypassing that transaction).\n      match /messages/{messageId} {\n        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;\n        allow create: if isSignedIn() &&\n          request.resource.data.senderId == request.auth.uid &&\n          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&\n          (\n            get(/databases/$(database)/documents/chats/$(chatId)).data.status != 'pending' ||\n            (\n              request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('requestedBy', '') &&\n              get(/databases/$(database)/documents/chats/$(chatId)).data.get('pendingMessageCount', 0) < 1\n            )\n          );\n        allow update: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;\n        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;\n      }\n    }\n\n    // calls/{callId} — WebRTC signaling for 1:1 voice/video calls\n    // (callService.js). Restricted to the two named participants\n    // (callerUid/calleeUid) in every direction, the same participant-\n    // only pattern as chats/{chatId} above. offer/answer SDP live on\n    // the call doc itself; ICE candidates live in two subcollections\n    // (one per side) so each side can only ever write its OWN\n    // candidates, never forge the other's.\n    match /calls/{callId} {\n      allow read: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);\n      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerUid;\n      allow update: if isSignedIn() && (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);\n      allow delete: if false;\n\n      match /callerCandidates/{candidateId} {\n        allow read: if isSignedIn() && (\n          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||\n          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid\n        );\n        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid;\n        allow update, delete: if false;\n      }\n      match /calleeCandidates/{candidateId} {\n        allow read: if isSignedIn() && (\n          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||\n          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid\n        );\n        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid;\n        allow update, delete: if false;\n      }\n    }\n\n    // communities/{communityId} — public discovery read. Create by the\n    // declared owner only. Update: the owner may change anything;\n    // an existing admin may change only the fields\n    // updateCommunityDetails's own comment documents as admin-editable\n    // (description/coverImage/icon/tags/rules) plus the admins/\n    // moderators arrays (promote/demote); any signed-in user may adjust\n    // ONLY membersCount, as a side effect of joining/leaving. Delete is\n    // owner-only (deleteCommunity).\n    match /communities/{communityId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;\n      allow update: if isSignedIn() && (\n        resource.data.ownerId == request.auth.uid ||\n        (request.auth.uid in resource.data.admins &&\n          onlyChanged(['description', 'coverImage', 'icon', 'tags', 'rules', 'admins', 'moderators'])) ||\n        onlyChanged(['membersCount'])\n      );\n      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;\n    }\n\n    // communityMembers/{communityId}_{uid} — communityService.js's own\n    // comment confirms the schema. Read open (member lists/roles are\n    // normal social-app data, not private). Create: the member joining\n    // themselves (joinCommunity/createCommunity's owner doc), OR the\n    // community's owner/admin admitting someone else (acceptRequest).\n    // Update/delete (role changes, leaving, being removed): the member\n    // themselves, or the community's owner/admin.\n    match /communityMembers/{memberId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && (\n        request.resource.data.uid == request.auth.uid ||\n        get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.ownerId == request.auth.uid ||\n        request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.admins\n      );\n      allow update: if isSignedIn() && (\n        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||\n        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins\n      );\n      allow delete: if isSignedIn() && (\n        resource.data.uid == request.auth.uid ||\n        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||\n        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins\n      );\n    }\n\n    // communityRequests/{communityId}_{uid} — requestToJoin creates its\n    // own; read/delete available to the requester themselves or the\n    // community's owner/admin (viewing/accepting/rejecting requests).\n    match /communityRequests/{requestId} {\n      allow read: if isSignedIn() && (\n        resource.data.uid == request.auth.uid ||\n        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||\n        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins\n      );\n      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow delete: if isSignedIn() && (\n        resource.data.uid == request.auth.uid ||\n        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == request.auth.uid ||\n        request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.admins\n      );\n      allow update: if false;\n    }\n\n    // communityHandles/{handle} — same reservation pattern as\n    // usernames/{}. Read open (handle-availability checks); create/\n    // delete restricted to the reservation's own owner (createCommunity\n    // reserves it, deleteCommunity releases it).\n    match /communityHandles/{handle} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;\n      allow update: if false;\n    }\n\n    // colleges/{collegeId} — public reference data (onboarding college\n    // search, community college filter). Read-only for clients; writes\n    // only ever happen via collegeRequestService.js's admin-approval\n    // transaction, which this pass deliberately does NOT re-enable —\n    // that flow depends on the platformAdmins-based admin check this\n    // project has already moved away from (see final report). Colleges\n    // already in the database remain fully readable either way.\n    match /colleges/{collegeId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    // collegeRequests/{requestId} — any signed-in user may submit a\n    // request to add a missing college (AddCollegePage.jsx). Reading/\n    // reviewing requests is an admin action, intentionally left\n    // unavailable for the same reason as colleges/ above.\n    match /collegeRequests/{requestId} {\n      allow create: if isSignedIn();\n      allow read, update, delete: if false;\n    }\n\n    // lostFound/{itemId} — public campus board; only the poster can\n    // edit/remove their own listing (createLostFoundItem's own comment:\n    // \"authenticated uid passed in — never trusted from anywhere else\").\n    match /lostFound/{itemId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;\n      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;\n    }\n\n    // products/{productId} — Marketplace. marketplaceService.js's own\n    // comment confirms the intent exactly: \"the real authorization\n    // boundary is the Firestore rule itself ... never trust sellerId\n    // from client.\" Public read (browsing/searching listings); create\n    // requires the declared sellerId to match the requester; only the\n    // seller may edit or remove their own listing. This collection had\n    // zero rule coverage before this pass — the same class of gap as\n    // chats/communities/follows found and fixed earlier — which is why\n    // Marketplace never actually loaded any data despite real products\n    // existing in the database.\n    match /products/{productId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;\n      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;\n    }\n\n    // savedItems/{uid}/items/{itemId} and savedCollections/{uid}/collections/{id}\n    // — private, owner-only bookmarking system (savedService.js).\n    match /savedItems/{uid}/items/{itemId} {\n      allow read, write: if isOwner(uid);\n    }\n    match /savedCollections/{uid}/collections/{collectionId} {\n      allow read, write: if isOwner(uid);\n    }\n\n    // reports/{reportId} — reportService.js's own comment documents the\n    // exact intended rule: create requires reporterUid == requester;\n    // read/update/delete are admin-only. Admin review now happens via\n    // adminResolveReport/adminListReports (Cloud Functions, Admin SDK —\n    // bypasses these rules entirely), not a client-side platformAdmins\n    // check, so read/update/delete stay denied for every client here.\n    match /reports/{reportId} {\n      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;\n      allow read, update, delete: if false;\n    }\n\n    // radarLocations/{uid} — radarLocationService.js's own comment\n    // documents this exactly: \"Read: any signed-in user (required)...\n    // Write: owner only.\"\n    match /radarLocations/{uid} {\n      allow read: if isSignedIn();\n      allow write: if isOwner(uid);\n    }\n\n    // Gamification — userProgress/{uid}, userBadges/{uid}/earned/{id},\n    // xpLog/{uid}/entries/{id}. XP/badges are awarded to OTHER users as\n    // a side effect of their actions (e.g. liking someone's post awards\n    // THEM xp, not you), so these cannot be owner-only for write.\n    // Treated as coarse-grained, low-stakes data (consistent with how\n    // likesCount/followersCount/membersCount are already handled above)\n    // rather than gated field-by-field.\n    match /userProgress/{uid} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn();\n    }\n    match /userBadges/{uid}/earned/{badgeId} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn();\n    }\n    match /xpLog/{uid}/entries/{entryId} {\n      allow read: if isSignedIn();\n      allow write: if isSignedIn();\n    }\n\n    // verificationRequests/{requestId} — created during onboarding's\n    // campus-verification step. Only the submitting user may create or\n    // read their own request; no listing, no updates, no deletes from\n    // the client (reviewed by an admin process later).\n    match /verificationRequests/{requestId} {\n      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;\n      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;\n      allow update, delete: if false;\n    }\n\n    // emailVerificationTokens/{tokenHash} — custom email verification.\n    // Written and read exclusively by Cloud Functions via the Admin SDK\n    // (which bypasses these rules entirely), never by the client. No\n    // client, including the token's own owner, may create, read,\n    // update, or delete a token, or otherwise influence emailVerified.\n    // Already covered by the catch-all below; stated explicitly here\n    // for auditability given how security-sensitive this collection is.\n    match /emailVerificationTokens/{tokenHash} {\n      allow read, write: if false;\n    }\n\n    // emailVerificationRateLimits/{uid} — server-only counters backing\n    // resendEmailVerification's rate limit. Same rationale as above.\n    match /emailVerificationRateLimits/{uid} {\n      allow read, write: if false;\n    }\n\n    // emailVerificationActiveTokens/{uid} — server-only pointer to each\n    // user's current live token, used to invalidate a previous token\n    // without a compound query. Same rationale as above.\n    match /emailVerificationActiveTokens/{uid} {\n      allow read, write: if false;\n    }\n\n    // Deny everything else by default — Firestore is NOT public.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-15T09:02:05.704175Z","metadata":{"services":["cloud.firestore"]}}
